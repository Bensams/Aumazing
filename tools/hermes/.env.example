# Copy to .env in this same folder and fill in ONE provider key.
# .env is gitignored — never commit the real file.

# OpenRouter — matches the base_url already in ~/.hermes/config.yaml.
OPENROUTER_API_KEY=

# Or go direct to Anthropic instead (then run: hermes config set model.provider anthropic)
# ANTHROPIC_API_KEY=

# Optional: lets Hermes open PRs / read issues on the capstone repo.
# GITHUB_TOKEN=
