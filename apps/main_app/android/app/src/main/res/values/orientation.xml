<?xml version="1.0" encoding="utf-8"?>
<!-- Startup orientation for MainActivity, resolved by Android from the *device*
     configuration before the window exists — unlike a runtime check, which can
     only see the (possibly already letterboxed) Flutter window.

     Values are android.content.pm.ActivityInfo constants. This default applies
     to phones: SCREEN_ORIENTATION_PORTRAIT. See values-sw600dp for tablets. -->
<resources>
    <integer name="app_start_screen_orientation">1</integer>
</resources>
