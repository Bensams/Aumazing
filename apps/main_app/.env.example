# Aumazing Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Supabase Configuration (from https://supabase.com/dashboard)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth (from https://console.cloud.google.com/apis/credentials)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id

# Facebook OAuth (from https://developers.facebook.com/apps)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token
